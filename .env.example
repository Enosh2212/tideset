# Environment Configuration for TIDESET
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET=""
ALLOW_DEMO_SWITCH="false"

# Database (SQLite for local zero-config testing / Postgres for production)
DATABASE_URL="file:./dev.db"

# PayPal Sandbox Credentials (REST API v2)
# Create a Sandbox App at https://developer.paypal.com/dashboard/applications/sandbox
# Mode can be 'sandbox' or 'live'
PAYPAL_MODE="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="<your_sandbox_client_id>"
PAYPAL_CLIENT_ID="<your_sandbox_client_id>"
PAYPAL_CLIENT_SECRET="<your_sandbox_client_secret>"
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID="<your_sandbox_webhook_id>"

# OpenRouter Free AI Configuration
# Get a free API key at https://openrouter.ai/keys
# Recommended model: openrouter/free (automatically routes to active free models)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
